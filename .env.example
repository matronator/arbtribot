# ==== General ====
SIMULATION_MODE=true
DEBUG_MODE=true
VERBOSE_LOGGING=false
TRADING_MODE=normal                    # Options: triangle, grid, normal (default: triangle)
WD_ENABLED=true

# ==== Binance keys ====
BINANCE_API_KEY="KEY_HERE"
BINANCE_SECRET_KEY="SECRET_HERE"

# ==== Normal mode settings ====
TRADING_USD_AMOUNT=5
TRADING_MAX_POSITIONS=5
TRADING_MIN_PROFIT=0.02
TRADING_STOP_LOSS=0.01
TRADING_PROFIT_TARGET=0.02
TRADING_MAX_HOLD_TIME=15
TRADING_BASE_ASSET=USDC
TRADING_QUOTE_ASSETS=BTC,BNB,ETH,XRP,LTC,SOL,DOT,DOGE,TRX

# ==== Grid mode settings ====
GRID_MIN_PRICE_CHANGE=0.005         # 0.5% minimum price change to detect trends
GRID_PROFIT_TARGET=0.02             # 2% profit target
GRID_STOP_LOSS=0.01                 # 1% stop loss
GRID_MAX_HOLD_TIME=30               # 30 minutes maximum hold time
GRID_MAX_POSITIONS=3                # Maximum 5 concurrent positions
GRID_CHECK_INTERVAL=5              # Check prices every 10 seconds

# ==== Triangle mode settings ====
BINANCE_FEE_RATE=0.00075
ORDER_USDC_AMOUNT=10
SIMULATION_USDC_AMOUNT=5000
BASE_ASSETS=USDC,BTC,ETH,BNB,DOGE,TRX,XRP
START_ASSET=USDC
