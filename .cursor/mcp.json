{
    "mcpServers": {
      "cursor10x-mcp": {
        "type": "stdio",
        "command": "pnpx",
        "args": ["cursor10x-mcp"],
        "enabled": true,
        "env": {
          "TURSO_DATABASE_URL": "${env:TURSO_DATABASE_URL}",
          "TURSO_AUTH_TOKEN": "${env:TURSO_AUTH_TOKEN}"
        },
        "envFile": "${workspaceFolder}/.env.cursor"
      }
    }
  }